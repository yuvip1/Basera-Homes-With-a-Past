# Basera Environment Configuration
# Phase 0: These are variable names only — never commit real secrets

# Database
DATABASE_URL="postgresql://basera_app:${POSTGRES_PASSWORD}@localhost:5432/basera"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="false"
GOOGLE_CLIENT_ID="change-me"
GOOGLE_CLIENT_SECRET="change-me"
NEXTAUTH_SECRET="change-me-in-production"

# Exchange Credential (separate from NEXTAUTH_SECRET)
EXCHANGE_SIGNING_KEY="change-me-exchange"
EXCHANGE_ISSUER="basera-exchange"
EXCHANGE_AUDIENCE="basera-api"
EXCHANGE_CLOCK_SKEW="60"
EXCHANGE_REPLAY_RETENTION_MS="86400000"

# API JWT Configuration
API_JWT_ISSUER="basera-backend"
API_JWT_AUDIENCE="basera-api"
API_JWT_EXPIRES_IN="5m"

# Payments (test mode only)
RAZORPAY_KEY_ID="test_key_id"
RAZORPAY_KEY_SECRET="test_key_secret"

# Email
RESEND_API_KEY="change-me"
EMAIL_FROM="onboarding@resend.dev"

# Cloudinary (images)
CLOUDINARY_CLOUD_NAME="change-me"
CLOUDINARY_API_KEY="change-me"
CLOUDINARY_API_SECRET="change-me"

# AI/ML (research track)
OPENAI_API_KEY="change-me"
ANTHROPIC_API_KEY="change-me"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"